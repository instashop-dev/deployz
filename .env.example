# Deployz environment — placeholders only. Copy to .env and fill in real values.
# .env is gitignored; never commit secrets.

# --- Database (packages/db) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deployz

# --- Auth (Better Auth: email/password + GitHub OAuth + organization) ---
BETTER_AUTH_SECRET=replace_me
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me

# --- Stripe billing ($49 base + $19/healthy-deployment metered) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_BASE=price_replace_me
STRIPE_PRICE_DEPLOYMENT=price_replace_me

# --- GitHub App (installation / trust flow) ---
GITHUB_APP_ID=replace_me
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace_me\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace_me

# --- AWS / CDK (control plane, us-east-1) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=replace_me
CDK_DEFAULT_ACCOUNT=replace_me
CDK_DEFAULT_REGION=us-east-1
