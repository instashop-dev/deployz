{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBootstrapVersion",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1:151955775369:parameter/cdk-bootstrap/hnb659fds/version"
    },
    {
      "Sid": "AssumeCdkBootstrapRoles",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Resource": "arn:aws:iam::151955775369:role/cdk-hnb659fds-*-151955775369-us-east-1"
    }
  ]
}
