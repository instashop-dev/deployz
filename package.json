{
  "name": "deployz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e": "node scripts/e2e.mjs",
    "e2e:scenarios": "node scripts/e2e.mjs --scenarios",
    "e2e:canary": "node scripts/e2e.mjs --mode=canary",
    "e2e:fresh": "node scripts/e2e.mjs --mode=fresh",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "admin:customer-cleanup": "tsx scripts/customer-reset/index.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1115.0",
    "@aws-sdk/client-elasticache": "^3.1115.0",
    "@aws-sdk/client-eventbridge": "^3.1115.0",
    "@aws-sdk/client-rds": "^3.1115.0",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@deployz/contracts": "workspace:*",
    "@deployz/db": "workspace:*",
    "@deployz/relay": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "aws-cdk": "^2.1138.0",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "pg": "^8.13.0",
    "turbo": "^2.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
