# Per-attempt evidence written to a custom --evidence-dir. These ledgers
# carry the run's vendor session (series.json holds an email and password),
# so every evidence directory stays out of git, not just the default one.
docs/testing/repository-deployment/runs/evidence-*/

# Fresh-100 campaign: caches, snapshots, raw logs, temporary build contexts
# and atomic-write temp files stay local. Manifests, labels, state and
# redacted results under campaign/ stay tracked.
campaign/.cache/
campaign/logs/
campaign/tmp/
campaign/**/*.log
campaign/**/*.tmp

# scripts/customer-reset inventory/verify output — an operator-run snapshot
# of live customer installations, regenerated by `pnpm admin:customer-cleanup
# inventory`, not durable project state.
/customer-cleanup-manifest.json
/customer-cleanup-protected.json
